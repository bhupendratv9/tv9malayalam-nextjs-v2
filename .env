# ─────────────────────────────────────────────
# Deployment
# ─────────────────────────────────────────────
# basePath is hardcoded in next.config.js — no env var needed

# ─────────────────────────────────────────────
# API – Server-side (NOT exposed to the browser)
# ─────────────────────────────────────────────
# Mode: "s3" (static JSON from CDN) or "api" (dynamic page builder API)
PORT=3000
PAGE_BUILDER_MODE=s3
#Upadted
#PAGE_BUILDER_MODE=api

# S3 mode config
API_BASE_URL=https://api.tv9tamil.com/pagebuilder-apis

###Updated##
#API_BASE_URL=https://pbapi.tv9tamil.com/pagebuilder

API_ENV=development
API_SITE_NAME=tv9malayalam

# API mode config (used when PAGE_BUILDER_MODE=api)
# API_BASE_URL=https://apipublish.tv9hindi.com/page-builder
# API_SITE_ID=6
# API_CHANNEL_ID=1
# API_LOCALE_ID=1

# ─────────────────────────────────────────────
# API – Public (exposed to the browser via NEXT_PUBLIC_)
# ─────────────────────────────────────────────
#NEXT_PUBLIC_API_BASE_URL=https://apipublish.tv9hindi.com/page-builder
###Updated##
#NEXT_PUBLIC_API_BASE_URL=https://pbapi.tv9tamil.com/pagebuilder

# Site canonical domain (no trailing slash)
#NEXT_PUBLIC_SITE_URL=https://alphapublish.tv9hindi.com/tv9tamil-nextjs

# Site identity (from siteSettings — used server-side where context isn't available)
###Need check start#
NEXT_PUBLIC_SITE_NAME=tv9malayalam
NEXT_PUBLIC_SITE_LOGO_URL=https://images.malayalamtv9.com/uploads/tv9-malyalam-logo.svg
NEXT_PUBLIC_SITE_LANGUAGE=ml
NEXT_PUBLIC_JWPLAYER_PLAYER_ID=xd4KY5Tn
###Need check start end #
# Regex pattern for domains to rewrite to SITE_URL
# Live host: malayalamtv9.com | CMS Alpha publish host: alphapublish.tv9hindi.com (§12)
#NEXT_PUBLIC_SITE_REWRITE_PATTERN=^https?://(www|app|alpha|alphapublish)\\.malayalamtv9\\.com
NEXT_PUBLIC_SITE_REWRITE_PATTERN=^https?://(www|app|alpha|alphapublish)\\.(malayalamtv9\\.com|tv9hindi\\.com)


NEXT_PUBLIC_SITE_URL=http://localhost:3000/tv9malayalam-nextjs

# ─────────────────────────────────────────────
# Proxy — Origin for sitemap, ads.txt, robots.txt etc.
# ─────────────────────────────────────────────
PROXY_ORIGIN=https://www.malayalamtv9.com

# ─────────────────────────────────────────────
# Menu API
# ─────────────────────────────────────────────
#MENU_API_BASE_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphaup/pagecategory
# MENU_API_BASE_URL=https://apipublish1.tv9hindi.com/wpapis/development/tv9up/menus
#MENU_API_BASE_URL=https://apipublish1.tv9hindi.com/wpapis/development/tv9up/menus

MENU_API_BASE_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphamalayalam/pagecategory

#MENU_API_BASE_URL=https://pbapi.tv9up.com/wpapis/development/tv9up/menus
MAIN_NAV_MENU_SLUG=header-menu
TRENDING_MENU_SLUG=trending-tags

#########need check start#########
TOP_CITIES_MENU_SLUG=top-cities
BOTTOM_NAV_MENU_SLUG=bottom-nav
###Need check start end #

#########need check end#########
# CDN / static assets base URL
NEXT_PUBLIC_STATIC_CDN_URL=https://static.tv9hindi.com
# Asset prefix — serves _next/static/* from appstatic.tv9tamil.com
# This moves JS/CSS off your main domain so Google doesn't crawl them
#NEXT_PUBLIC_ASSET_PREFIX=https://appstatic.tv9tamil.com
# Local static deploy directory (for Apache-served static domain)
STATIC_DEPLOY_DIR=/var/www/html/alphapublish/tv9malayalam-nextjs

# Header & footer stylesheet
#NEXT_PUBLIC_HEADER_FOOTER_CSS_URL=https://alphapublish.tv9hindi.com/assets/tv9tamil-nextjs/header-footer.css

# Election widget API base
#NEXT_PUBLIC_ELECTION_API_BASE_URL=https://d2mbatxl9mg7js.cloudfront.net/election/ts/vs/dashboard/en

DISABLE_CACHE=true

# Web Story Detail API base
#WEBSTORY_API_BASE_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphatamil/1min/pagecategory

#WEBSTORY_API_BASE_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphaup/pagecategory

WEBSTORY_API_BASE_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphamalayalam/pagecategory

###need check start#########
SHORT_VIDEO_API_BASE_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphamalayalam/pagecategory/short-video-detail
###need check end#########


###need check start#########
# Next Article Infinite Scroll (detail API for fetching article by ID)
NEXT_ARTICLE_API_URL=https://apipublish1.tv9hindi.com/apis/page-builder/alphamalayalam/pagecategory/detail/{id}
###need check end#########


# Ads Control (also controlled via siteSettings in page builder)
# Set to "0" to disable all ads site-wide (overrides siteSettings)
NEXT_PUBLIC_ADS_ENABLED=1
NEXT_PUBLIC_TABOOLA_ENABLED=1
# Link Navigation: 1 = Next.js Link (SPA, no reload), 0 = plain <a> (full reload, ads re-fire)
NEXT_PUBLIC_USE_LINK_NAVIGATION=0